# ==========================================
# Python Core
# ==========================================
# Ignores compiled byte-code files that Python generates automatically
__pycache__/
*.py[cod]
*$py.class

# ==========================================
# Virtual Environments
# ==========================================
# Ignores the heavy folders where Python installs local libraries
venv/
.venv/
env/
.env/
conda/
miniconda/

# ==========================================
# Project Data & Simulation Outputs
# ==========================================
# CRITICAL: Prevents students from pushing massive datasets to GitHub.
# If you want them to commit small sample datasets, create a "sample_data/" 
# folder and do not list it here.
*.csv
*.log
*.dat
*.json
outputs/
results/
data/

# ==========================================
# Jupyter Notebooks
# ==========================================
# Ignores the hidden auto-save folders Jupyter creates
.ipynb_checkpoints/

# ==========================================
# Secrets & API Keys
# ==========================================
# Essential if you eventually use LLMs (like OpenAI/Anthropic) for agents
.env
secret.py

# ==========================================
# IDEs & OS-Specific Junk
# ==========================================
# Ignores personalized VS Code settings and Mac/Windows background files
.vscode/
.idea/
.DS_Store
Thumbs.db
