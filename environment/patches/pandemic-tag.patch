diff --git a/src/main/java/games/pandemic/PandemicActionSpace.java b/src/main/java/games/pandemic/PandemicActionSpace.java
new file mode 100644
index 000000000..485c69481
--- /dev/null
+++ b/src/main/java/games/pandemic/PandemicActionSpace.java
@@ -0,0 +1,244 @@
+package games.pandemic;
+
+import core.AbstractGameState;
+import core.actions.AbstractAction;
+import core.actions.DrawCard;
+import core.actions.RearrangeDeckOfCards;
+import core.actions.RemoveComponentFromDeck;
+import core.components.Card;
+import core.components.Deck;
+import core.properties.PropertyString;
+import games.pandemic.actions.AddResearchStation;
+import games.pandemic.actions.AddResearchStationFrom;
+import games.pandemic.actions.AddResearchStationWithCard;
+import games.pandemic.actions.AddResearchStationWithCardFrom;
+import games.pandemic.actions.CureDisease;
+import games.pandemic.actions.MovePlayer;
+import games.pandemic.actions.MovePlayerWithCard;
+import games.pandemic.actions.ShareKnowledge;
+import games.pandemic.actions.TreatDisease;
+import org.json.simple.JSONArray;
+import org.json.simple.JSONObject;
+import static core.CoreConstants.nameHash;
+import static core.CoreConstants.playerHandHash;
+
+import java.nio.charset.StandardCharsets;
+import java.util.*;
+
+/** Fixed, sparse action IDs. TAG supplies every legal action; this class only indexes them. */
+public final class PandemicActionSpace {
+    public static final int SIZE = 131072;
+    private final AbstractAction[] actions = new AbstractAction[SIZE];
+    private final int[] mask = new int[SIZE];
+    private final String[] labels = new String[SIZE];
+    private final String[] assigned = new String[SIZE];
+    private final Map<String, Integer> keyToId = new HashMap<>();
+    private final JSONArray legalActions = new JSONArray();
+
+    public int size() { return SIZE; }
+    public int[] mask() { return mask.clone(); }
+    public AbstractAction action(int id) {
+        return id >= 0 && id < SIZE ? actions[id] : null;
+    }
+    public String label(int id) {
+        return id >= 0 && id < SIZE ? labels[id] : null;
+    }
+    public String legalActionsJson() { return legalActions.toJSONString(); }
+    public void clear() {
+        Arrays.fill(actions, null);
+        Arrays.fill(mask, 0);
+        Arrays.fill(labels, null);
+        legalActions.clear();
+    }
+
+    public void update(List<AbstractAction> legal, AbstractGameState observation) {
+        clear();
+        TreeMap<String, AbstractAction> keyed = new TreeMap<>();
+        for (AbstractAction action : legal) {
+            String key = key(action, observation);
+            if (keyed.put(key, action) != null)
+                throw new IllegalStateException("Pandemic action key collision: " + key);
+        }
+        for (Map.Entry<String, AbstractAction> entry : keyed.entrySet()) {
+            String key = entry.getKey();
+            Integer known = keyToId.get(key);
+            int id = known == null ? hash(key) & (SIZE - 1) : known;
+            if (known == null) {
+                while (assigned[id] != null) id = (id + 1) & (SIZE - 1);
+                assigned[id] = key;
+                keyToId.put(key, id);
+            }
+            mask[id] = 1;
+            actions[id] = entry.getValue();
+            JSONObject descriptor = describe(key, id, entry.getValue(), observation);
+            labels[id] = (String) descriptor.get("label");
+            legalActions.add(descriptor);
+        }
+    }
+
+    private static int hash(String key) {
+        // FNV-1a over UTF-8; deterministic across Java processes and platforms.
+        int h = 0x811c9dc5;
+        for (byte b : key.getBytes(StandardCharsets.UTF_8)) {
+            h ^= b & 0xff;
+            h *= 0x01000193;
+        }
+        return h;
+    }
+
+    public static String key(AbstractAction action, AbstractGameState state) {
+        String prefix = "p" + state.getCurrentPlayer() + ":" + action.getClass().getSimpleName() + ":";
+        if (action instanceof RearrangeDeckOfCards) {
+            return prefix + Arrays.toString(((RearrangeDeckOfCards) action).getNewCardOrder());
+        }
+        if (action instanceof CureDisease) {
+            CureDisease cure = (CureDisease) action;
+            List<String> cards = new ArrayList<>();
+            for (Integer id : cure.getCards())
+                cards.add(cardNameById(state, id));
+            Collections.sort(cards);
+            return prefix + cure.getColor() + ":" + cards;
+        }
+        if (action instanceof AddResearchStationWithCardFrom) {
+            AddResearchStationWithCardFrom station = (AddResearchStationWithCardFrom) action;
+            return prefix + station.getCity() + ":" + station.getFromCity() + ":"
+                    + state.getComponentById(station.getSourceDeckId()).getComponentName() + ":"
+                    + cardName(station.getCard(state));
+        }
+        if (action instanceof AddResearchStationWithCard) {
+            AddResearchStationWithCard station = (AddResearchStationWithCard) action;
+            return prefix + station.getCity() + ":"
+                    + state.getComponentById(station.getSourceDeckId()).getComponentName() + ":"
+                    + cardName(station.getCard(state));
+        }
+        if (action instanceof MovePlayerWithCard) {
+            MovePlayerWithCard move = (MovePlayerWithCard) action;
+            Card card = move.getCard(state);
+            String source = move.cardDeckFrom < 0 ? "hand of p" + move.playerDiscarding
+                    : state.getComponentById(move.cardDeckFrom).getComponentName();
+            return prefix + move.toString()
+                    .replace("card " + move.cardIdx, "card " + cardName(card))
+                    .replace(" from " + move.cardDeckFrom, " from " + source);
+        }
+        if (action instanceof ShareKnowledge) return prefix + action.getString(state);
+        if (action instanceof RemoveComponentFromDeck) {
+            RemoveComponentFromDeck<?> remove = (RemoveComponentFromDeck<?>) action;
+            Deck<?> deck = (Deck<?>) state.getComponentById(remove.getDeck());
+            return prefix + (deck == null ? remove.getDeck() + ":" + remove.getComponentIdx()
+                    : cardName((Card) deck.get(remove.getComponentIdx())));
+        }
+        if (action instanceof DrawCard) {
+            DrawCard draw = (DrawCard) action;
+            Card card = draw.getCard(state);
+            return prefix + (state.getComponentById(draw.getDeckFrom()) == null ? draw.getDeckFrom() : state.getComponentById(draw.getDeckFrom()).getComponentName())
+                    + ":" + (state.getComponentById(draw.getDeckTo()) == null ? draw.getDeckTo() : state.getComponentById(draw.getDeckTo()).getComponentName())
+                    + ":" + (card == null ? draw.getFromIndex() : cardName(card))
+                    + ":" + (state.getComponentById(draw.getDeckFrom()) == null ? "" : state.getComponentById(draw.getDeckFrom()).getOwnerId());
+        }
+        return prefix + action.toString();
+    }
+
+    private static String cardName(Card card) {
+        PropertyString property = (PropertyString) card.getProperty(nameHash);
+        return property == null ? card.getComponentName() : property.value;
+    }
+
+    private static String cardNameById(AbstractGameState state, int id) {
+        if (state.getComponentById(id) instanceof Card)
+            return cardName((Card) state.getComponentById(id));
+        PandemicGameState pandemic = (PandemicGameState) state;
+        for (int player = 0; player < state.getNPlayers(); player++) {
+            Deck<Card> hand = (Deck<Card>) pandemic.getComponent(playerHandHash, player);
+            for (Card card : hand.getComponents())
+                if (card.getComponentID() == id) return cardName(card);
+        }
+        throw new IllegalStateException("Cure action refers to a card outside visible hands: " + id);
+    }
+
+    @SuppressWarnings("unchecked")
+    private static JSONObject describe(String key, int maskIndex, AbstractAction action, AbstractGameState state) {
+        JSONObject result = new JSONObject();
+        JSONObject details = new JSONObject();
+        String type = action.getClass().getSimpleName();
+        String label = action.toString();
+        details.put("type", type);
+        if (action instanceof MovePlayer) {
+            MovePlayer move = (MovePlayer) action;
+            details.put("move_type", move.getMoveType().name());
+            details.put("city", move.getDestination());
+            details.put("target_player", move.getPlayerToMove());
+            if (action instanceof MovePlayerWithCard) {
+                MovePlayerWithCard withCard = (MovePlayerWithCard) action;
+                String card = cardName(withCard.getCard(state));
+                details.put("card", card);
+                details.put("card_owner", withCard.playerDiscarding);
+                label = move.getMoveType() + ": move player " + move.getPlayerToMove()
+                        + " to " + move.getDestination() + " using " + card;
+            }
+        } else if (action instanceof TreatDisease) {
+            TreatDisease treat = (TreatDisease) action;
+            details.put("city", treat.getCity());
+            details.put("color", treat.getColor());
+            details.put("treat_all", treat.isTreatAll());
+        } else if (action instanceof CureDisease) {
+            CureDisease cure = (CureDisease) action;
+            details.put("color", cure.getColor());
+            JSONArray cards = new JSONArray();
+            for (Integer cardId : cure.getCards()) cards.add(cardNameById(state, cardId));
+            details.put("cards", cards);
+            label = "Cure " + cure.getColor() + " using " + cards;
+        } else if (action instanceof AddResearchStation) {
+            AddResearchStation station = (AddResearchStation) action;
+            details.put("city", station.getCity());
+            if (action instanceof AddResearchStationFrom)
+                details.put("from_city", ((AddResearchStationFrom) action).getFromCity());
+            Card card = action instanceof AddResearchStationWithCardFrom
+                    ? ((AddResearchStationWithCardFrom) action).getCard(state)
+                    : action instanceof AddResearchStationWithCard
+                    ? ((AddResearchStationWithCard) action).getCard(state) : null;
+            if (card != null) {
+                details.put("card", cardName(card));
+                int sourceId = action instanceof AddResearchStationWithCardFrom
+                        ? ((AddResearchStationWithCardFrom) action).getSourceDeckId()
+                        : ((AddResearchStationWithCard) action).getSourceDeckId();
+                details.put("source", state.getComponentById(sourceId).getComponentName());
+                label += " using " + cardName(card);
+            }
+        } else if (action instanceof ShareKnowledge) {
+            ShareKnowledge share = (ShareKnowledge) action;
+            String card = cardName(share.getCard(state));
+            details.put("card", card);
+            details.put("source_player", share.getGiver());
+            details.put("target_player", share.getReceiver());
+            label = "Share " + card + " from player " + share.getGiver() + " to player " + share.getReceiver();
+        } else if (action instanceof RearrangeDeckOfCards) {
+            JSONArray order = new JSONArray();
+            for (int index : ((RearrangeDeckOfCards) action).getNewCardOrder()) order.add(index);
+            details.put("order", order);
+            label = "Forecast: reorder infection cards " + order;
+        } else if (action instanceof RemoveComponentFromDeck) {
+            RemoveComponentFromDeck<?> remove = (RemoveComponentFromDeck<?>) action;
+            Deck<?> deck = (Deck<?>) state.getComponentById(remove.getDeck());
+            String card = cardName((Card) deck.get(remove.getComponentIdx()));
+            details.put("card", cardName(remove.getCard(state)));
+            details.put("removed_card", card);
+            label = "Resilient Population: remove " + card;
+        } else if (action instanceof DrawCard) {
+            DrawCard draw = (DrawCard) action;
+            Card card = draw.getCard(state);
+            if (card != null) {
+                details.put("card", cardName(card));
+                label = type + ": " + cardName(card);
+            }
+            if (state.getComponentById(draw.getDeckFrom()) != null)
+                details.put("source", state.getComponentById(draw.getDeckFrom()).getComponentName());
+            if (state.getComponentById(draw.getDeckTo()) != null)
+                details.put("destination", state.getComponentById(draw.getDeckTo()).getComponentName());
+        }
+        result.put("id", key);
+        result.put("label", label);
+        result.put("mask_index", maskIndex);
+        result.put("details", details);
+        return result;
+    }
+}
