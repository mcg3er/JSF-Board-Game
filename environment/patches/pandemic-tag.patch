+package games.pandemic;
+
+import core.AbstractGameState;
+import core.components.*;
+import core.interfaces.IStateFeatureJSON;
+import core.properties.*;
+import org.json.simple.JSONArray;
+import org.json.simple.JSONObject;
+import utilities.Hash;
+
+import java.util.*;
+
+import static core.CoreConstants.*;
+import static games.pandemic.PandemicConstants.*;
+
+/** Public board and hands plus the acting player's Forecast knowledge. Never serializes hidden decks. */
+public class PandemicFeatures implements IStateFeatureJSON {
+    private static String name(Component component) {
+        PropertyString p = (PropertyString) component.getProperty(nameHash);
+        return p == null ? component.getComponentName() : p.value;
+    }
+
+    private static JSONArray cards(Deck<Card> deck) {
+        JSONArray result = new JSONArray();
+        for (Card card : deck.getComponents()) result.add(name(card));
+        return result;
+    }
+
+    @Override
+    @SuppressWarnings("unchecked")
+    public String getObservationJson(AbstractGameState gameState, int playerId) {
+        PandemicGameState state = (PandemicGameState) gameState;
+        JSONObject result = new JSONObject();
+        result.put("player_id", playerId);
+        result.put("n_players", state.getNPlayers());
+        result.put("phase", state.getGamePhase().toString());
+        result.put("turn_step", ((PandemicTurnOrder) state.getTurnOrder()).getTurnStep());
+        result.put("round", state.getRoundCounter());
+        result.put("quiet_night", state.isQuietNight());
+        result.put("epidemic", state.isEpidemic());
+        result.put("cards_drawn", state.getNCardsDrawn());
+
+        JSONArray players = new JSONArray();
+        for (int id = 0; id < state.getNPlayers(); id++) {
+            JSONObject player = new JSONObject();
+            Card role = (Card) state.getComponent(playerCardHash, id);
+            player.put("role", state.getPlayerRole(id));
+            player.put("location", ((PropertyString) role.getProperty(playerLocationHash)).value);
+            player.put("hand", cards((Deck<Card>) state.getComponent(playerHandHash, id)));
+            players.add(player);
+        }
+        result.put("players", players);
+
+        TreeMap<String, JSONObject> cities = new TreeMap<>();
+        for (BoardNode node : state.getWorld().getBoardNodes()) {
+            JSONObject city = new JSONObject();
+            JSONArray cityCubes = new JSONArray();
+            for (int amount : ((PropertyIntArray) node.getProperty(infectionHash)).getValues()) cityCubes.add(amount);
+            city.put("cubes", cityCubes);
+            city.put("research_station", ((PropertyBoolean) node.getProperty(researchStationHash)).value);
+            cities.put(name(node), city);
+        }
+        result.put("cities", cities);
+
+        JSONObject tracks = new JSONObject();
+        tracks.put("infection_rate", ((Counter) state.getComponent(infectionRateHash)).getValue());
+        tracks.put("outbreaks", ((Counter) state.getComponent(outbreaksHash)).getValue());
+        tracks.put("research_stations_available", ((Counter) state.getComponent(researchStationHash)).getValue());
+        JSONObject diseases = new JSONObject();
+        JSONObject cubes = new JSONObject();
+        for (String color : colors) {
+            diseases.put(color, ((Counter) state.getComponent(Hash.GetInstance().hash("Disease " + color))).getValue());
+            cubes.put(color, ((Counter) state.getComponent(Hash.GetInstance().hash("Disease Cube " + color))).getValue());
+        }
+        tracks.put("cures", diseases);
+        tracks.put("cubes_available", cubes);
+        result.put("tracks", tracks);
+
+        Deck<Card> playerDeck = (Deck<Card>) state.getComponent(playerDeckHash);
+        Deck<Card> infectionDeck = (Deck<Card>) state.getComponent(infectionHash);
+        result.put("player_deck_count", playerDeck.getSize());
+        result.put("infection_deck_count", infectionDeck.getSize());
+        result.put("player_discard", cards((Deck<Card>) state.getComponent(playerDeckDiscardHash)));
+        result.put("infection_discard", cards((Deck<Card>) state.getComponent(infectionDiscardHash)));
+        result.put("planner_card", cards((Deck<Card>) state.getComponent(plannerDeckHash)));
+        if (state.getGamePhase() == PandemicGameState.PandemicGamePhase.Forecast) {
+            JSONArray top = new JSONArray();
+            int count = Math.min(infectionDeck.getSize(), ((PandemicParameters) state.getGameParameters()).nForecastCards);
+            for (int i = 0; i < count; i++) top.add(name(infectionDeck.get(i)));
+            result.put("forecast_cards", top);
+        }
+        return result.toJSONString();
+    }
+}
